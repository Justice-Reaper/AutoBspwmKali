#!/bin/bash

scope_file="/home/user_replace/.config/bin/scope"
script_name="add-to-scope"

usage() {
    echo "Usage:"
    echo "  $script_name -a asset1 asset2 ..."
    echo "  $script_name -f file.txt"
    exit 1
}

[[ "$#" -eq 0 ]] && usage

add_asset() {
    local asset="$1"
    if grep -qxF "$asset" "$scope_file"; then
        echo "WARNING: '$asset' already in scope, skipping"
    else
        echo "$asset" >> "$scope_file"
    fi
}

case "$1" in
    -a)
        shift
        [[ "$#" -eq 0 ]] && usage
        for asset in "$@"; do
            add_asset "$asset"
        done
        ;;
    -f)
        [[ -z "$2" ]] && usage
        [[ ! -f "$2" ]] && echo "ERROR: file not found: $2" >&2 && exit 1
        while IFS= read -r asset; do
            [[ -z "$asset" ]] && continue
            add_asset "$asset"
        done < "$2"
        ;;
    *)
        usage
        ;;
esac
