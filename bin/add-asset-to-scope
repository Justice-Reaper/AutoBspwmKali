#!/bin/bash

SCOPE_FILE="/home/user_replace/.config/bin/scope"

usage() {
    echo "Usage:"
    echo "  add-to-scope -a asset1 asset2 ..."
    echo "  add-to-scope -f file.txt"
    exit 1
}

[[ "$#" -eq 0 ]] && usage

add_asset() {
    local asset="$1"
    if grep -qxF "$asset" "$SCOPE_FILE"; then
        echo "WARNING: '$asset' already in scope, skipping"
    else
        echo "$asset" >> "$SCOPE_FILE"
    fi
}

case "$1" in
    -a)
        shift
        [[ "$#" -eq 0 ]] && usage
        for asset in "$@"; do
            add_asset "$asset"
        done
        ;;
    -f)
        [[ -z "$2" ]] && usage
        [[ ! -f "$2" ]] && echo "ERROR: file not found: $2" >&2 && exit 1
        while IFS= read -r asset; do
            [[ -z "$asset" ]] && continue
            add_asset "$asset"
        done < "$2"
        ;;
    *)
        usage
        ;;
esac
