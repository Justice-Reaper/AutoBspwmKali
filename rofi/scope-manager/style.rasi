/*****----- Configuration -----*****/
configuration {
    modi:                       "dmenu";
    show-icons:                 false;
    scroll-method:              0;
    normalize-match:            true;
    sort:                       true;
    sorting-method:             "fzf";
    tokenize:                   true;
    matching:                   "fuzzy";

    /*---------- Keybindings ----------*/
    kb-move-front:              "KP_Home";
    kb-row-first:               "";
    kb-move-end:                "KP_End";
    kb-row-last:                "";
    kb-move-word-back:          "Alt+Left";
    kb-move-word-forward:       "Alt+Right";
    kb-remove-word-back:        "Alt+BackSpace";
    kb-remove-word-forward:     "Alt+Delete";
    kb-remove-to-sol:           "Ctrl+u";
    kb-remove-to-eol:           "Ctrl+k";
    kb-clear-line:              "Ctrl+w";
}

/*****----- Colors -----*****/
* {    
    selected:        #70A5EB;
    black:           #101419;
    white:           #DEE1E6;
    gray:            #28344a;
    red:             #E05F65;
}

/*****----- Fonts -----*****/
* {
    font: "JetBrains Mono Nerd Font 10";
}

/*****----- Main Window -----*****/
window {
    transparency:                "real";
    location:                    north;
    anchor:                      north;
    fullscreen:                  false;
    x-offset:                    -525px;
    y-offset:                    57px;
    enabled:                     true;
    margin:                      0px;
    padding:                     0px;
    border:                      2px solid;
    border-radius:               0px;
    border-color:                @gray;
    background-color:            @black;
    cursor:                      "default";
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                     true;
    spacing:                     10px;
    margin:                      0px;
    padding:                     20px;
    border:                      0px solid;
    border-radius:               0px 0px 0px 0px;
    border-color:                transparent;
    background-color:            transparent;
    children:                    [ "inputbar", "listview"];
}

/*****----- Inputbar -----*****/
inputbar {
    enabled:                     true;
    spacing:                     10px;
    margin:                      0px 0px 5px 0px;
    padding:                     10px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                transparent;
    background-color:            transparent;
    text-color:                  @white;
    children:                    [ "prompt", "entry" ];
}

prompt {
    enabled:                     true;
    background-color:            inherit;
    text-color:                  inherit;
}

entry {
    enabled:                     true;
    background-color:            inherit;
    text-color:                  inherit;
    cursor:                      text;
    placeholder:                 "Search...";
    placeholder-color:           inherit;
}

/*****----- Listview -----*****/
listview {
    enabled:                     true;
    columns:                     1;
    lines:                       9;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   true;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;
    
    spacing:                     10px;
    margin:                      0px;
    padding:                     0px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                transparent;
    background-color:            transparent;
    text-color:                  @white;
    cursor:                      "default";
}

scrollbar {
    margin:                      0px 0px 0px 5px;
    handle-width:                5px;
    handle-color:                @selected;
    border-radius:               0px;
    background-color:            @gray;
    cursor:                      default;
}

/*****----- Elements -----*****/
element {
    enabled:                     true;
    spacing:                     10px;
    margin:                      0px;
    padding:                     5px;
    border:                      0px solid;
    border-radius:               10px;
    border-color:                transparent;
    background-color:            transparent;
    text-color:                  @white;
    cursor:                      pointer;
}

element normal.normal {
    background-color:            transparent;
    text-color:                  @white;
}

element selected.normal {
    background-color:            @selected;
    text-color:                  @black;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    highlight:                   inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}
