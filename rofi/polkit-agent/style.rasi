/*****----- Colors -----*****/
* {
    black:           #101419;
    white:           #DEE1E6;
    blue:            #70A5EB;
    gray:            #28344a;
}

/*****----- Fonts -----*****/
* {
    font: "JetBrains Mono Nerd Font 10";
}

/*****----- Main Window -----*****/
window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       800px;
    x-offset:                    0px;
    y-offset:                    0px;
    enabled:                     true;
    margin:                      0px;
    padding:                     0px;
    border:                      2px solid;
    border-radius:               0px;
    border-color:                @gray;
    background-color:            @black;
    cursor:                      "default";
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                     true;
    spacing:                     15px;
    margin:                      0px;
    padding:                     15px;
    border:                      0px solid;
    border-radius:               0px 0px 0px 0px;
    border-color:                transparent;
    background-color:            transparent;
    children:                    [ "inputbar", "message" ];
}

/*****----- Inputbar -----*****/
inputbar {
    enabled:                     true;
    spacing:                     0px;
    margin:                      0px;
    padding:                     0px;
    border:                      0px solid;
    background-color:            @black;
    text-color:                  @blue;
    children:                    [ "prompt", "entry" ];
}

prompt {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  @blue;
}

entry {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  @blue;
    cursor:                      text;
    placeholder:                 "";
    placeholder-color:           transparent;
}

/*****----- Message -----*****/
textbox {
    margin:                      0px;
    padding:                     0px;
    background-color:            @black;
    text-color:                  @blue;
    vertical-align:              0.5;
    horizontal-align:            0.0;
    highlight:                   none;
}
